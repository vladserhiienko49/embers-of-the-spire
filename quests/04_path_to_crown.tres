[resource]
script = ExtResource("3_hvloq")
id = "path_to_crown"
title = "Шлях до Корони"
category = "Сюжетне доручення"
giver_id = "npc_lamplighter"
giver_name = "Ліхтарник Орест"
description = "Щоночі на вершині Чорної Гори жевріє вінець вогню. Орест вважає, що там досі лежить останнє послання короля. Піднімись серпантином до руїн Попелястої Корони й дізнайся правду."
prerequisites = Array[String](["lamplighter_oil"])
objectives = Array[ExtResource("1_y0ywb")]([SubResource("Resource_1rtbr"), SubResource("Resource_sqvgd"), SubResource("Resource_cjt13"), SubResource("Resource_ggps8")])
rewards = Array[ExtResource("2_l4dhe")]([SubResource("Resource_5u5bp")])
dialogue_offer = "Мій батько служив у варті Корони. Він казав, що в ніч падіння король піднявся на вершину сам і залишив там послання для того, хто прийде після нього.

Серпантин починається там, де дорога з села впирається в гору. Іди вночі, бо віхи вздовж стежки світять тільки в темряві."
accept_label = "ПРИЙНЯТИ: ШЛЯХ ДО КОРОНИ"
dialogue_active = "Вінець на вершині сьогодні горить яскравіше. Ніби хтось на тебе чекає."
dialogue_ready = "Ти був там... Що написав король? Ні, не кажи всього. Досить знати, що він не втік."
turn_in_label = "РОЗПОВІСТИ ПРО ПОСЛАННЯ"
dialogue_done = "Якщо Корона ще тліє, значить, королівство не вмерло до кінця. Бережи себе на тій горі."
